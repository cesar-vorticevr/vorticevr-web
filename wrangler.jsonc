{
  // Sitio estático de Vórtice VR servido con Cloudflare Workers (static assets).
  "name": "vorticevr-web",
  "compatibility_date": "2026-09-01",
  // Dominios propios conectados al Worker (Cloudflare crea los registros DNS).
  "routes": [
    { "pattern": "vorticevr.mx", "custom_domain": true },
    { "pattern": "www.vorticevr.mx", "custom_domain": true },
    { "pattern": "t.vorticevr.mx", "custom_domain": true }
  ],
  // Worker in front of every request: Range for videos, nombre.vorticevr.mx experiences, /api and /m (AR platform).
  "main": "worker.js",
  // Needed by `wrangler preview`, which Cloudflare runs for non-production branches (rama preview).
  "previews": {},
  // Keep the preview URLs on (<branch>-vorticevr-web.lad-cesargarcia.workers.dev) and the production
  // workers.dev URL off; without these keys every production deploy switched the previews off.
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
